# Dummy development values only. Use a separate ignored file for real secrets.
POSTGRES_PASSWORD=example-local-only
DATABASE_URL=postgres://knowslink:example-local-only@postgres:5432/knowslink?sslmode=disable
RELAY_PORT=8080
# Default profile does not start cloudflared. A real token is required for tunnel.
TUNNEL_TOKEN=
# Local synthetic /v1/owners fixture only. Public deployments leave it unset.
KNOWSLINK_SYNTHETIC_SIGNUP=1
# Email login: smtps://user:token@host:465 or smtp://host:port. Unset means code mail cannot be sent.
KNOWSLINK_SMTP_URL=
KNOWSLINK_MAIL_FROM=
# Set to CF-Connecting-IP only when the relay is reachable solely through the Tunnel.
KNOWSLINK_CLIENT_IP_HEADER=
