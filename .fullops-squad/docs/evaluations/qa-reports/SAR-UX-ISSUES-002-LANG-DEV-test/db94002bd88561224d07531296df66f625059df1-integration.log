        .shell{display:grid;grid-template-columns:184px minmax(0,1fr);gap:24px}.workspace{min-width:0}.nav,.toc{display:flex;flex-direction:column;align-self:start;gap:4px}.nav a,.toc a{padding:8px 12px;text-decoration:none;color:var(--ink)}.toc-title{padding:8px 12px 0;color:var(--muted);font-size:14px}.nav a[aria-current],.conversation-list a[aria-current]{border-left:3px solid var(--accent);background:var(--selected);font-weight:600}.chat-layout{display:grid;grid-template-columns:280px minmax(0,1fr);gap:24px}.conversation-list{border-right:1px solid var(--edge);padding-right:24px;min-width:0}.conversation-list ul,.people,.agents,.messages{list-style:none;padding:0;margin:0}.conversation-list a{display:block;padding:12px 8px;text-decoration:none;border-left:3px solid transparent}.conversation-list a:not(.button){color:var(--ink)}.person-name{font-size:18px;font-weight:600}.name-preview{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden}.agent-line{display:block;margin-left:16px;font-size:16px}.short{color:var(--muted);font-size:14px;overflow-wrap:anywhere}.people>li,.agents>li{padding:16px 0}.people .agents,.friend-agents{margin-left:16px}.messages>li{padding:16px 0 16px 16px;border-left:3px solid transparent}.messages>li.owner-message{border-left-color:var(--accent)}.message-meta{display:flex;flex-wrap:wrap;gap:4px 12px;margin-bottom:8px}.message-meta>*{min-width:0;max-width:100%;overflow-wrap:anywhere}.conversation-body{min-width:0}.message-meta time{color:var(--muted);font-size:14px}.message-text{white-space:pre-wrap;max-width:64ch;overflow-wrap:anywhere}.authorship{font-size:14px;background:var(--selected);padding:0 4px}.conversation-header{margin-bottom:24px}.conversation-header h1{margin-bottom:8px}.composer{margin-top:24px;max-width:64ch}.target{margin:12px 0;overflow-wrap:anywhere}.consent,.choice{display:flex;align-items:flex-start;gap:8px;font-weight:400}.consent input,.choice input{flex:0 0 24px;width:24px;min-height:44