        .agent-line.name-preview{display:-webkit-box}.conversation-header p{margin-bottom:4px}.conversation-header,.retention{margin-bottom:8px}.retention p{margin-bottom:0}.messages>li{padding-top:8px;padding-bottom:8px}.messages p{margin-bottom:8px}.messages>li>:last-child{margin-bottom:0}.composer{margin-top:16px}.composer textarea{min-height:96px}.composer .target{margin:8px 0}.conversation-details{margin-top:8px}
