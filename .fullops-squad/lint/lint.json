{
  "schema_version": 1,
  "commands": [
    {"name": "product-lint", "run": ["make", "lint"], "cwd": "."}
  ],
  "timeout_seconds": 600,
  "size": {
    "severity": "WARNING",
    "max_code_lines": 300,
    "max_doc_lines": 500
  },
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/vendor/**",
    "**/*.min.*",
    "**/*.lock",
    "**/package-lock.json",
    ".fullops-squad/handovers/**",
    ".fullops-squad/contexts/**",
    ".fullops-squad/docs/evaluations/**",
    ".fullops-squad/board/**",
    ".fullops-squad/docs/planning/sources/silent-agent-relay/**"
  ],
  "rules": []
}
