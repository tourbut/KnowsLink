{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"__import__('runpy').run_path(__import__('subprocess').check_output(['git','rev-parse','--show-toplevel'],text=True).strip()+'/scripts/shell_guard.py',run_name='__main__')\" ; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
